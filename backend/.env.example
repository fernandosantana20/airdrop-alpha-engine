# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended: gemini-2.5-flash (fast/cost-effective) or gemini-2.5-pro (deepest reasoning)
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Alerts (create via @BotFather and get chat_id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: GitHub Personal Access Token for higher rate limits (60 -> 5000 req/hr)
GITHUB_TOKEN=

# Database & Scheduler
DATABASE_URL=sqlite:///./airdrop_alpha.db
MONITOR_INTERVAL_MINUTES=60

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
